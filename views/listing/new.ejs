<% layout("/layouts/boilerplate.ejs") %>
<div class="row">
    <div class="col-8 offset-2" >
        <br><br>
    <h3>Create a new List</h3>
    <form method ="post"action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label"></label>
        <input name="listing[title]" placeholder="Enter title" type="text" class="form-control" required id="title">
        <div class="valid-feedback">Looks Good</div>

        </div>
        <div class="mb-3">
            <label for="Description" class="form-label">Description</label>
        <textarea name="listing[description]"  type="text" class="form-control" required  id="Description"></textarea>
        </div>
        
        <div class="mb-3" >
            <label for="Image" class="form-label"> Upload Listing Image</label>
        <input name="listing[image]"  type="file" class="form-control" id="Image">
        required
        </div>
      
       <div class="mb-3">
        <label for="Price" class="form-label">Price</label>
        <input name="listing[price]" class="form-control" type="number" id="Price">
        <div class="invalid-feedback">only letters allowed</div>
        </div>

        <div class="row">

        <div class="mb-3 col-4">
        <label for="location" class="form-label">Location</label>
        <input name="listing[location]"  class="form-control" required pattern="[A-Za-z\s]+" id="location"> 
        <div class="invalid-feedback">only letters allowed</div>
        </div>

        <div class="mb-3 col-8">
        <label for="Country" class="form-label">Country</label>
        <input name="listing[country]"  class="form-control" required type="text"  id="Country"> 
        <div class="invalid-feedback">Please enter valid country</div>

        </div>

        </div>
        <button class="btn btn-dark add-btn">Add</button>
    </form>
    </div>
    </div>
